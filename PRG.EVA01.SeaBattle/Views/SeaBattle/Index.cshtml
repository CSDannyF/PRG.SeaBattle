@model IEnumerable<PRG.EVA01.SeaBattle.Models.Game>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">New Game</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PlayerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartedPlayingOn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PlayerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartedPlayingOn)
            </td>
            <td>
                <a asp-controller="GameLogs" asp-action="GameDetails" asp-route-id="@item.Id">GameDetails</a> |
            </td>
            <td>
                <a asp-action="ThrowBomb" asp-route-id="@item.Id">Continue game</a>
            </td>
        </tr>
}
    </tbody>
</table>
