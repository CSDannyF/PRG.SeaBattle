@model PRG.EVA01.SeaBattle.ViewModels.SeaBattle.ThrowBombViewModel

@{
    ViewData["Title"] = "ThrowBomb";
}
@{
    var hide = "hidden";
    var borderColor = "";

    if (Model.Result != null)
    {
        switch (Model.Result)
        {
            case "HIT":
                borderColor = "green";
                break;
            case "MISS":
                borderColor = "orange";
                break;
            default:
                borderColor = "red";
                break;
        }
        hide = "";
    }
}

<h1>ThrowBomb</h1>
<h3>@Html.DisplayFor(model => model.PlayerName)</h3>

<div class="row">
    <div class="col-md-4" style="margin:auto 0">
        <form asp-action="ThrowBomb">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PlayerName" />
            <input type="hidden" asp-for="GameId" />
            <div class="form-group">
                <label asp-for="LocationLetter" class="control-label"></label>
                <input asp-for="LocationLetter" class="form-control" required />
                <span asp-validation-for="LocationLetter" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocationNumber" class="control-label"></label>
                <input asp-for="LocationNumber" class="form-control" required />
                <span asp-validation-for="LocationNumber" class="text-danger"></span>
            </div>
            <div class="from-group">
                <input type="submit" value="Throw bomb!" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div @hide style="border: @borderColor solid 3px; padding: 1em; width: 60%;">
    <p><strong>Throw Result</strong></p>
    <p>@Html.DisplayFor(model => model.Result)</p>
    <p>@Html.DisplayFor(model => model.TotalSunkenBoats)</p>
</div>